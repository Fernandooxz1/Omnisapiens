{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Los módulos puros de los juegos se importan con `.ts` para que Node los ejecute.
		"allowImportingTsExtensions": true,
		// Vite resuelve #lib por package.json; svelte-check necesita el mismo mapa acá.
		"paths": {
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	// El service worker usa `$service-worker` y los tipos de webworker, que chocan con el DOM.
	"exclude": ["src/service-worker.ts"]
}
