# Copiar a .env y ajustar los valores.
ENV=local
DATABASE_URL=postgresql+asyncpg://trivia:trivia@localhost:5432/trivia
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-cambiar
